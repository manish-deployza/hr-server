                <mxCell id="ep0" value="Every route, grouped by who may call it" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="700" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="epG0" value="Public  (SecurityConfig permitAll)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="40" y="70" width="880" height="26" as="geometry"/>
                </mxCell>
                <UserObject label="POST   /api/auth/signup              -&amp;gt; AckData      AuthFlow.signup&amp;#10;POST   /api/auth/login               -&amp;gt; AckData      AuthFlow.login   (sets cookie)&amp;#10;POST   /api/auth/logout              -&amp;gt; AckData      clears cookie&amp;#10;POST   /api/auth/forgot-password     -&amp;gt; AckData      PasswordResetMailer&amp;#10;POST   /api/auth/reset-password      -&amp;gt; AckData      AuthFlow&amp;#10;GET    /api/auth/verify-email?token= -&amp;gt; 302 redirect VerificationMailer token" tooltip="src/main/java/com/leaveapp/rest/AuthController.java" link="file:///C:/Users/Yamraj/Desktop/leave-backend/backend/src/main/java/com/leaveapp/rest/AuthController.java" id="epB0">
                    <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
                        <mxGeometry x="40" y="96" width="880" height="104" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="epG1" value="Any authenticated session" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="40" y="218" width="880" height="26" as="geometry"/>
                </mxCell>
                <UserObject label="GET    /api/auth/me                  -&amp;gt; SessionData        AuthController&amp;#10;POST   /api/auth/resend-verification -&amp;gt; AckData            AuthController&amp;#10;POST   /api/auth/change-password     -&amp;gt; AckData            AuthFlow&amp;#10;GET    /api/employees/me             -&amp;gt; SessionData        EmployeeFlow&amp;#10;PATCH  /api/employees/me             -&amp;gt; SessionData        EmployeeFlow&amp;#10;GET    /api/directory                -&amp;gt; Page&amp;lt;DirectoryData&amp;gt; DirectoryFlow&amp;#10;         org-scoped; sensitive fields masked, ORG_ADMIN sees them&amp;#10;GET    /api/leave-types              -&amp;gt; LeaveTypeData[]    LeaveFlow&amp;#10;GET    /api/leave-balances/me        -&amp;gt; LeaveBalanceData[] LeaveFlow (ledger)&amp;#10;POST   /api/leave-requests           -&amp;gt; LeaveApplyData     LeaveFlow.apply&amp;#10;GET    /api/leave-requests/me        -&amp;gt; LeaveRequestData[] LeaveFlow&amp;#10;GET    /api/leave-requests/{id}      -&amp;gt; LeaveRequestData   own, or HR/ORG_ADMIN&amp;#10;POST   /api/leave-requests/{id}/action -&amp;gt; AckData          LeaveApprovalService&amp;#10;         the one approve/reject route - manager AND HR use it&amp;#10;POST   /api/leave-requests/{id}/cancel -&amp;gt; AckData          LeaveFlow" tooltip="src/main/java/com/leaveapp/rest/EmployeeController.java" link="file:///C:/Users/Yamraj/Desktop/leave-backend/backend/src/main/java/com/leaveapp/rest/EmployeeController.java" id="epB1">
                    <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
                        <mxGeometry x="40" y="244" width="880" height="248" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="epG2" value="Manager  (checked in the flow, not SecurityConfig)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="40" y="510" width="880" height="26" as="geometry"/>
                </mxCell>
                <UserObject label="GET    /api/manager/team             -&amp;gt; TeamMemberData[]   ManagerLeaveFlow&amp;#10;GET    /api/manager/leave-requests   -&amp;gt; LeaveRequestData[] direct reports only" tooltip="src/main/java/com/leaveapp/rest/ManagerLeaveController.java" link="file:///C:/Users/Yamraj/Desktop/leave-backend/backend/src/main/java/com/leaveapp/rest/ManagerLeaveController.java" id="epB2">
                    <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
                        <mxGeometry x="40" y="536" width="880" height="40" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="epG3" value="ORG_ADMIN or HR   (/api/hr/** hasAnyRole)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="40" y="594" width="880" height="26" as="geometry"/>
                </mxCell>
                <UserObject label="GET    /api/hr/employees             -&amp;gt; EmployeeRowData[]  HrEmployeeFlow (unpaged)&amp;#10;POST   /api/hr/employees             -&amp;gt; IdData             creates user + employee&amp;#10;POST   /api/hr/employees/import      -&amp;gt; EmployeeImportResultData  EmployeeImportFlow&amp;#10;PATCH  /api/hr/employees/{id}        -&amp;gt; EmployeeRowData    PATCH semantics&amp;#10;DELETE /api/hr/employees/{id}        -&amp;gt; AckData            soft delete, idempotent&amp;#10;         is_active=false + status=EXITED + date_of_exit=today&amp;#10;GET    /api/hr/leave-requests        -&amp;gt; LeaveRequestData[] company-wide&amp;#10;GET    /api/hr/leave-types           -&amp;gt; LeaveTypeData[]    HrLeaveFlow&amp;#10;POST   /api/hr/leave-types           -&amp;gt; IdData&amp;#10;PATCH  /api/hr/leave-types/{id}      -&amp;gt; AckData&amp;#10;DELETE /api/hr/leave-types/{id}      -&amp;gt; AckData&amp;#10;GET    /api/hr/holidays              -&amp;gt; HolidayData[]      read only&amp;#10;         HR may only touch EMPLOYEE rows; ORG_ADMIN may touch HR too" tooltip="src/main/java/com/leaveapp/rest/HrEmployeeController.java" link="file:///C:/Users/Yamraj/Desktop/leave-backend/backend/src/main/java/com/leaveapp/rest/HrEmployeeController.java" id="epB3">
                    <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
                        <mxGeometry x="40" y="620" width="880" height="216" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="epG4" value="ORG_ADMIN only" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="854" width="880" height="26" as="geometry"/>
                </mxCell>
                <UserObject label="POST   /api/directory                -&amp;gt; IdData        DirectoryFlow -&amp;gt; HrEmployeeFlow&amp;#10;PATCH  /api/directory/{id}           -&amp;gt; DirectoryData&amp;#10;DELETE /api/directory/{id}           -&amp;gt; AckData       deactivate&amp;#10;GET    /api/organization             -&amp;gt; OrgData       OrgFlow&amp;#10;PATCH  /api/organization             -&amp;gt; OrgData       OrgFlow" tooltip="src/main/java/com/leaveapp/rest/OrgController.java" link="file:///C:/Users/Yamraj/Desktop/leave-backend/backend/src/main/java/com/leaveapp/rest/OrgController.java" id="epB4">
                    <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
                        <mxGeometry x="40" y="880" width="880" height="88" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="Order matters in SecurityConfig: /api/hr/** and /api/organization/** and the&amp;#10;directory write rules are all declared before anyRequest().authenticated().&amp;#10;&amp;#10;Two guard layers:&amp;#10;  1. SecurityConfig - URL + role, coarse&amp;#10;  2. AbstractController.requireRole / requireAnyRole / hasRole - per method&amp;#10;  3. the *Flow - row-level: is this row in MY org, is this MY report&amp;#10;&amp;#10;Everything unauthenticated ends at RestAuthEntryPoint -&amp;gt; 401 JSON ErrorData.&amp;#10;Every thrown BadRequest/NotFound/Conflict lands in GlobalExceptionHandler." tooltip="src/main/java/com/leaveapp/config/SecurityConfig.java" link="file:///C:/Users/Yamraj/Desktop/leave-backend/backend/src/main/java/com/leaveapp/config/SecurityConfig.java" id="epNote">
                    <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#333333;" parent="1" vertex="1">
                        <mxGeometry x="950" y="70" width="400" height="230" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="Request DTOs are model/form/*Form (bean-validated).&amp;#10;Response DTOs are model/data/*Data - never an entity.&amp;#10;PwdDeserializer keeps raw passwords out of logs." tooltip="src/main/java/com/leaveapp/model" link="file:///C:/Users/Yamraj/Desktop/leave-backend/backend/src/main/java/com/leaveapp/model" id="epNote2">
                    <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#333333;" parent="1" vertex="1">
                        <mxGeometry x="950" y="320" width="400" height="90" as="geometry"/>
                    </mxCell>
                </UserObject>
            </root>
        </mxGraphModel>
    </diagram>
